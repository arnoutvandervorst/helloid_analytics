# HelloID tenant to export from. Copy to .env and fill in; .env is gitignored.
# The API key needs read access to Service Automation products and product assignments.
# Generate one at: HelloID portal → Security → API keys
HELLOID_URL=https://your-company-name.helloid.com
HELLOID_API_KEY=
HELLOID_API_SECRET=

# HelloID audit log (helloid-audit.py). Enable the Elastic API key at
# https://<tenant>.helloid.com/admin/elasticapikey — it shows the URL, key and secret.
HELLOID_ELASTIC_URL=https://<region>.helloid.cloud/service/elastic-proxy/elastic
HELLOID_ELASTIC_KEY=
HELLOID_ELASTIC_SECRET=
