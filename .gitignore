# Exports stay out of the repo — they carry account, person and contract data.
# demo/ is the exception: generated by make-demo-set.py, invented from end to end.
*.csv
vault*.json
Vault*.json
*-vault.json

!demo/*.csv
!demo/*.json

# Build output; build.py regenerates it.
dist/

# Tenant credentials for helloid-export.py. Never commit; .env.example is the template.
.env

# Exports pulled from a live tenant.
product-assignments.csv
products.json

# Deployment notes for a specific host: hostnames, users and internal addresses.
deploy-local/
DEPLOY-NUC.md

# Session state and OS noise
.remember/
.DS_Store
